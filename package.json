    "@types/react-gtm-module": "2.0.3",
    "@types/styled-components": "5.1.34",
    "babel-plugin-macros": "3.1.0",
    "graphql.macro": "^1.4.2",
    "sass": "1.70.0",
    "storybook": "10.4.0",
    "@storybook/addon-docs": "10.4.0"
  }
